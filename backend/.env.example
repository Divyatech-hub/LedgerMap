DATABASE_URL=postgresql+asyncpg://ledgermap:ledgermap@localhost:5432/ledgermap
APP_ENV=development
LOG_LEVEL=INFO

# LLM classification of lines that exact/fuzzy matching can't resolve.
LLM_CLASSIFICATION_ENABLED=false
LLM_PROVIDER=gemini
# Gemini authenticates with Application Default Credentials, not a key:
# run `gcloud auth application-default login` once on your machine.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
